# Copia este archivo como .env y coloca tu clave de OpenAI.
# Copy this file to .env and put your OpenAI API key here.
OPENAI_API_KEY=sk-your-key-here

# Opcional: modelo por defecto (también se puede pasar con --model).
# Optional: default model (can also be passed with --model).
PDF2LATEX_MODEL=gpt-4o
